# Public site origin (no trailing slash). Used for canonical URLs, sitemap, hreflang and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.jkspeedydrivingschool.com

# [CONFIRM] WhatsApp number in international format, digits only (e.g. 19085551234).
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Lead delivery. The booking form POSTs JSON here (GoHighLevel inbound webhook, Zapier "Catch Hook", Make, etc.).
LEAD_WEBHOOK_URL=
# Optional shared secret sent as the X-Webhook-Secret header to LEAD_WEBHOOK_URL.
LEAD_WEBHOOK_SECRET=

# Email fallback (used when the webhook is unset or fails). Uses the Resend HTTP API.
RESEND_API_KEY=
LEAD_EMAIL_TO=
LEAD_EMAIL_FROM="JK Speedy Website <leads@yourdomain.com>"
